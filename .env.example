# Modal GPU type (optional; defaults to A100)
MODAL_GPU=A100

# Local checkpoint destination (optional; defaults to ./checkpoints)
MODEL_CHECKPOINTS_DIR=checkpoints

# Required locally when W&B logging is enabled
WANDB_API_KEY=replace-with-your-wandb-api-key

# Required locally when pushing checkpoints to Hugging Face
HF_TOKEN=hf_replace_with_your-token
